<Window x:Class="revit_mcp_plugin.UI.TestToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCP Tool Tests" Height="680" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Server status + element ID row -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Grid.Column="1" x:Name="ServerStatusText" Text="●" FontSize="18"
                       Foreground="Gray" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="2" x:Name="ServerStatusLabel" Text="Unknown"
                       VerticalAlignment="Center" Foreground="Gray"/>
            <TextBlock Grid.Column="3" Text="Element ID:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox  Grid.Column="4" x:Name="ElementIdBox" VerticalAlignment="Center"
                      Padding="4,2" ToolTip="Element ID required for element-specific tests. Select an element in Revit and click 'Get Selected'."/>
        </Grid>

        <!-- Action bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnCheckServer" Content="Check Server" Padding="8,4" Margin="0,0,6,0" Click="BtnCheckServer_Click"/>
            <Button x:Name="BtnGetSelected" Content="Get Selected Element ID" Padding="8,4" Margin="0,0,6,0" Click="BtnGetSelected_Click"/>
            <Button x:Name="BtnRunAll" Content="▶  Run All Tests" Padding="10,4" Margin="0,0,6,0"
                    Background="#2196F3" Foreground="White" FontWeight="Bold" Click="BtnRunAll_Click"/>
            <Button x:Name="BtnClear" Content="Clear" Padding="8,4" Click="BtnClear_Click"/>
        </StackPanel>

        <!-- Test list -->
        <ListView Grid.Row="2" x:Name="TestListView" BorderThickness="1" BorderBrush="#DDD">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Tool" Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Description" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Status" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                           FontWeight="Bold" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Run" Padding="4,2" FontSize="10"
                                        Tag="{Binding}" Click="BtnRunSingle_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Progress bar -->
        <ProgressBar Grid.Row="3" x:Name="ProgressBar" Height="6" Margin="0,6,0,0"
                     Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>

        <!-- Result area -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Last Result:" FontWeight="Bold" Margin="0,0,0,4"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="11" Background="#F8F8F8"
                         Padding="6" BorderThickness="1" BorderBrush="#DDD"
                         VerticalScrollBarVisibility="Auto"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
